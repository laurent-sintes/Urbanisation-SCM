{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aspect-specific adoption decisions",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "decision_state": {
            "enum": [
              "accepted",
              "rejected",
              "withdrawn",
              "superseded"
            ]
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "decided_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "recorded_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "interpretation": {
            "enum": [
              "explicit",
              "contextual"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "note": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "properties": {
              "collection": {
                "enum": [
                  "nodes",
                  "relations",
                  "principles"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer"
              },
              "approved_fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "value_sha256": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "import_version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "collection",
              "id",
              "revision",
              "approved_fields",
              "value_sha256",
              "import_version"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "decision_state",
          "author",
          "decided_at",
          "recorded_at",
          "interpretation",
          "source_refs",
          "note",
          "target"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "version",
    "decisions"
  ],
  "additionalProperties": false
}
