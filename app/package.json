{
  "name": "flow-atlas",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Explorateur statique du modÃƒÂ¨le publiÃƒÂ© FLOW : React et React Flow.",
  "scripts": {
    "dev": "pnpm run export && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "python ../scripts/build_atlas.py",
    "build:frontend": "python ../scripts/build_atlas.py --frontend",
    "build:full": "python ../scripts/build_atlas.py --full-export",
    "test": "node --test --test-isolation=none test-*.mjs",
    "check:code": "biome check --diagnostic-level=warn --error-on-warnings .",
    "benchmark:search": "node benchmark-search.mjs",
    "format:code": "biome check --write .",
    "verify": "pnpm run check:code && python ../scripts/verify_atlas.py",
    "verify:map-placement": "node verify-map-placement.mjs",
    "verify:catalogue-page": "node verify-catalogue-page.mjs",
    "verify:catalogue-width": "node verify-catalogue-page.mjs --width",
    "verify:flows": "node verify-flow-map.mjs",
    "verify:map-hotspots": "node verify-map-hotspot-matrix.mjs",
    "verify:process-management": "node verify-process-management.mjs",
    "verify:pedagogy": "node verify-pedagogy.mjs",
    "verify:content": "node verify-published-content.mjs",
    "verify:candidate": "node verify-published-content.mjs --candidate",
    "verify:ux": "node verify-ux.mjs",
    "verify:applications": "node verify-application-picker.mjs && node verify-applications.mjs",
    "verify:hotspots": "node verify-hotspots.mjs && node verify-hotspot-clusters.mjs && node verify-hotspot-depths.mjs && node verify-map-hotspot-matrix.mjs && node verify-hotspot-audit.mjs && node verify-hotspot-visibility.mjs",
    "verify:hotspot-clusters": "node verify-hotspot-clusters.mjs",
    "verify:hotspot-resolution": "node verify-hotspot-resolution.mjs",
    "verify:hotspot-detail": "node verify-hotspot-detail.mjs",
    "verify:codes": "node verify-display-codes.mjs",
    "verify:behaviors": "pnpm run verify",
    "verify:market": "pnpm run verify",
    "verify:principles": "node verify-modeling-guide.mjs",
    "verify:dependencies": "pnpm run verify",
    "verify:presentation": "pnpm run verify",
    "export": "python ../scripts/export_atlas.py",
    "export:full": "python ../scripts/export_atlas.py --full",
    "verify:static": "node verify-static.mjs",
    "verify:serial": "pnpm run check:code && node verify-browser.mjs && node verify-map-history.mjs && node verify-map-placement.mjs && node verify-flow-map.mjs && node verify-static.mjs && node verify-modeling-guide.mjs && node verify-display-codes.mjs && node verify-ux.mjs && node verify-published-content.mjs && node verify-process-management.mjs && pnpm run verify:hotspots && pnpm run verify:hotspot-resolution && pnpm run verify:hotspot-detail && node verify-application-picker.mjs && node verify-catalogue-page.mjs --ci && node verify-catalogue-page.mjs --width --ci"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@xyflow/react": "12.11.6",
    "elkjs": "0.12.0",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
